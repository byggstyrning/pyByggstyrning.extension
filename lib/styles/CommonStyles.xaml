<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:local="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         pyByggstyrning design system
         Color roles:
           Accent (brand yellow)  = primary actions, selected tabs/segments
           Selection (blue)       = selection, checked state, keyboard focus
           Success/Error/Warning  = semantic status only
           Neutrals               = surfaces, borders, text
         Values below are the LIGHT theme defaults; lib/styles/__init__.py
         overrides every Color/Brush at load time per Revit theme, so any
         change here must be mirrored in LIGHT_THEME_COLORS/DARK_THEME_COLORS.
         All brush references inside styles use DynamicResource so the
         runtime theme override reaches every template.
         ============================================================ -->

    <!-- Color Palette -->
    <Color x:Key="PlaceholderForegroundColor">#6B7280</Color>
    <Color x:Key="BusyOverlayColor">#A6000000</Color>
    <Color x:Key="AccentColor">#FFBB00</Color>
    <Color x:Key="AccentHoverColor">#EBA700</Color>
    <Color x:Key="AccentPressedColor">#D69800</Color>
    <Color x:Key="SelectionColor">#0078D4</Color>
    <Color x:Key="SelectionHoverColor">#106EBE</Color>
    <Color x:Key="SelectionIndicatorColor">#0078D4</Color>
    <Color x:Key="ProgressFillColor">#0078D4</Color>
    <Color x:Key="ErrorColor">#C62828</Color>
    <Color x:Key="ErrorHoverColor">#B02525</Color>
    <Color x:Key="ErrorPressedColor">#8E1C1C</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="SuccessHoverColor">#27692B</Color>
    <Color x:Key="SuccessPressedColor">#1B5E20</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="BorderColor">#D5D9DE</Color>
    <Color x:Key="BackgroundLightColor">#F4F5F7</Color>
    <Color x:Key="BackgroundLighterColor">#EAECEF</Color>
    <Color x:Key="TextColor">#1F2328</Color>
    <Color x:Key="TextSecondaryColor">#5B6470</Color>
    <Color x:Key="TextLightColor">#8B939E</Color>
    <Color x:Key="DisabledColor">#E4E7EB</Color>
    <Color x:Key="DisabledTextColor">#9AA1AA</Color>
    <Color x:Key="WindowBackgroundColor">#FAFAFA</Color>
    <Color x:Key="ControlBackgroundColor">#FFFFFF</Color>
    <Color x:Key="PopupBackgroundColor">#FFFFFF</Color>
    <Color x:Key="DataGridRowBackgroundColor">#FFFFFF</Color>
    <Color x:Key="ArrowColor">#6B7280</Color>
    <Color x:Key="ColoredButtonTextColor">#1A1A1A</Color>
    <Color x:Key="SemanticButtonTextColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PlaceholderForegroundBrush" Color="{StaticResource PlaceholderForegroundColor}"/>
    <SolidColorBrush x:Key="BusyOverlayBrush" Color="{StaticResource BusyOverlayColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}"/>
    <SolidColorBrush x:Key="SelectionHoverBrush" Color="{StaticResource SelectionHoverColor}"/>
    <SolidColorBrush x:Key="SelectionIndicatorBrush" Color="{StaticResource SelectionIndicatorColor}"/>
    <SolidColorBrush x:Key="ProgressFillBrush" Color="{StaticResource ProgressFillColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{StaticResource ErrorHoverColor}"/>
    <SolidColorBrush x:Key="ErrorPressedBrush" Color="{StaticResource ErrorPressedColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessHoverBrush" Color="{StaticResource SuccessHoverColor}"/>
    <SolidColorBrush x:Key="SuccessPressedBrush" Color="{StaticResource SuccessPressedColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}"/>
    <SolidColorBrush x:Key="BackgroundLighterBrush" Color="{StaticResource BackgroundLighterColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}"/>
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="{StaticResource DataGridRowBackgroundColor}"/>
    <SolidColorBrush x:Key="ArrowBrush" Color="{StaticResource ArrowColor}"/>
    <SolidColorBrush x:Key="ColoredButtonTextBrush" Color="{StaticResource ColoredButtonTextColor}"/>
    <SolidColorBrush x:Key="SemanticButtonTextBrush" Color="{StaticResource SemanticButtonTextColor}"/>

    <!-- Shape tokens -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">6</CornerRadius>

    <!-- Spacing Resources (Thickness) -->
    <Thickness x:Key="DefaultMargin">5</Thickness>
    <Thickness x:Key="DefaultPadding">5</Thickness>
    <Thickness x:Key="SmallMargin">5,3</Thickness>
    <Thickness x:Key="SmallPadding">5,3</Thickness>
    <Thickness x:Key="MediumMargin">10</Thickness>
    <Thickness x:Key="MediumPadding">10</Thickness>
    <Thickness x:Key="LargeMargin">10,15</Thickness>
    <Thickness x:Key="LargePadding">10,15</Thickness>
    <Thickness x:Key="ButtonMargin">5</Thickness>
    <Thickness x:Key="ButtonPadding">12,0,12,1</Thickness>
    <Thickness x:Key="GridMargin">10</Thickness>
    <Thickness x:Key="StackPanelMargin">0,10,0,0</Thickness>
    <Thickness x:Key="TextBlockBottomMargin">0,0,0,10</Thickness>
    <Thickness x:Key="TextBlockVerticalMargin">0,10,0,10</Thickness>
    <Thickness x:Key="TextBlockSmallMargin">0,5,0,0</Thickness>
    <Thickness x:Key="GroupBoxMargin">0,0,0,10</Thickness>
    <Thickness x:Key="GroupBoxPadding">8</Thickness>

    <!-- Keyboard focus ring (blue outline, offset from the control) -->
    <Style x:Key="StandardFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               StrokeThickness="1.5"
                               Stroke="{DynamicResource SelectionIndicatorBrush}"
                               RadiusX="5" RadiusY="5"
                               SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ProgressBar style: themed fill (blue in light theme, accent in dark) on a quiet track -->
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource ProgressFillBrush}"/>
        <Setter Property="Background" Value="{DynamicResource BackgroundLighterBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- Implicit ToolTip style -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Placeholder TextBox Style (placeholder text comes from Tag) -->
    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid x:Name="contentGrid" Margin="{TemplateBinding Padding}">
                            <!-- Placeholder: behind the text input -->
                            <TextBlock x:Name="placeholder"
                                      Text="{TemplateBinding Tag}"
                                      Foreground="{DynamicResource PlaceholderForegroundBrush}"
                                      Margin="2,0,0,0"
                                      VerticalAlignment="Center"
                                      IsHitTestVisible="False"
                                      Visibility="Collapsed"/>

                            <!-- Text Area: Must be named PART_ContentHost -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="0"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Background="Transparent"
                                        Focusable="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Show placeholder only when Text is empty -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox Style (matches PlaceholderTextBoxStyle) -->
    <Style x:Key="PlaceholderPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource SelectionIndicatorBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Base Button Template (primary / accent) -->
    <ControlTemplate x:Key="BaseButtonTemplate" TargetType="Button">
        <Border x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ContentPresenter x:Name="contentPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                TextOptions.TextFormattingMode="Display"
                                SnapsToDevicePixels="True"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="{DynamicResource DisabledTextBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Standard Button Style (Primary, brand accent) -->
    <Style x:Key="StandardButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
        <Setter Property="Margin" Value="{StaticResource ButtonMargin}"/>
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ColoredButtonTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusVisualStyle}"/>
        <Setter Property="Template" Value="{StaticResource BaseButtonTemplate}"/>
    </Style>

    <!-- Secondary Button Style (quiet, bordered) -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
        <Setter Property="Margin" Value="{StaticResource ButtonMargin}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            TextBlock.Foreground="{TemplateBinding Foreground}"
                                            TextOptions.TextFormattingMode="Display"
                                            SnapsToDevicePixels="True"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource TextLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundLighterBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                            <Setter TargetName="contentPresenter" Property="TextBlock.Foreground" Value="{DynamicResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success Button Style -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}"/>
        <Setter Property="Margin" Value="{StaticResource ButtonMargin}"/>
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SemanticButtonTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource StandardFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
