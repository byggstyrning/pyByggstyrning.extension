<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">
    <!-- Styles are loaded programmatically via lib/styles (load_styles_to_window) -->
    <Page.Resources>
        <!-- Config card container: quiet card with a brand accent bar when selected -->
        <Style x:Key="ConfigCardContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="AccentBar"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        CornerRadius="5,0,0,5"
                                        Margin="1"/>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,7,10,7"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource TextLightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <DockPanel Margin="10">

        <!-- ======= Connection header ======= -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="accountDot"
                     Grid.Column="0"
                     Width="9" Height="9"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource TextLightBrush}"/>
            <TextBlock x:Name="accountText"
                       Grid.Column="1"
                       Margin="7,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextBrush}"
                       Text="StreamBIM · not signed in"/>
            <Button x:Name="signInButton"
                    Grid.Column="2"
                    Style="{DynamicResource LinkButtonStyle}"
                    VerticalAlignment="Center"
                    Margin="6,0"
                    ToolTip="Opens the Checklist Importer's sign-in form"
                    Content="Sign in..."/>
            <Button x:Name="refreshButton"
                    Grid.Column="3"
                    Style="{DynamicResource IconButtonStyle}"
                    ToolTip="Refresh connection and configurations"
                    Content="&#x27F3;"
                    FontSize="15"/>
        </Grid>

        <!-- Project / document context -->
        <TextBlock x:Name="projectText"
                   DockPanel.Dock="Top"
                   Margin="16,0,0,10"
                   FontSize="11"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text=""/>

        <!-- ======= Section header ======= -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="Import configurations"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Border Grid.Column="1" Style="{DynamicResource BadgeBorderStyle}">
                <TextBlock x:Name="configCountText"
                           Style="{DynamicResource BadgeTextStyle}"
                           Text="0"/>
            </Border>
        </Grid>

        <!-- ======= Run actions ======= -->
        <StackPanel DockPanel.Dock="Bottom">
            <!-- Progress strip (visible while a run is in flight) -->
            <StackPanel x:Name="progressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <ProgressBar x:Name="runProgress"
                             Height="5"
                             IsIndeterminate="True"/>
            </StackPanel>
            <TextBlock x:Name="statusText"
                       Margin="0,7,0,8"
                       FontSize="11"
                       TextWrapping="Wrap"
                       MaxHeight="64"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text=""/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="runSelectedButton"
                        Grid.Column="0"
                        Style="{DynamicResource StandardButtonStyle}"
                        Margin="0,0,3,0"
                        IsEnabled="False"
                        Content="Run selected"/>
                <Button x:Name="runAllButton"
                        Grid.Column="1"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Margin="3,0,0,0"
                        IsEnabled="False"
                        Content="Run all"/>
            </Grid>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="newConfigButton"
                        Grid.Column="0"
                        Style="{DynamicResource GhostButtonStyle}"
                        Margin="0,0,3,0"
                        ToolTip="Create a new import configuration (opens the Checklist Importer)"
                        Content="New config..."/>
                <Button x:Name="editConfigsButton"
                        Grid.Column="1"
                        Style="{DynamicResource GhostButtonStyle}"
                        Margin="3,0,0,0"
                        ToolTip="Review, edit or delete saved configurations (opens Edit Configs)"
                        Content="Edit configs..."/>
            </Grid>
        </StackPanel>

        <!-- ======= Config cards ======= -->
        <Grid>
            <ListBox x:Name="configsList"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource ConfigCardContainerStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Detail}"
                                       FontSize="11"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Meta}"
                                       FontSize="10.5"
                                       Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <StackPanel x:Name="emptyState"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="No import configurations"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="Save a mapping in the Checklist Importer and it will show up here."
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="220"
                           FontSize="11"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextLightBrush}"/>
            </StackPanel>
        </Grid>

    </DockPanel>
</Page>
