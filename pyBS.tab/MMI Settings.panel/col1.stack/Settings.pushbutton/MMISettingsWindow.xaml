<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMI Settings"
        Width="720"
        SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Window.Resources>
        <DataTemplate x:Key="MmiStepItemTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="SwatchBorder" Width="12" Height="12" Margin="0,0,6,0" CornerRadius="2"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        VerticalAlignment="Center" SnapsToDevicePixels="True"
                        Background="{Binding swatch_brush}"/>
                <TextBlock Text="{Binding label}" VerticalAlignment="Center" Margin="0" Padding="0"
                           FontSize="12" LineHeight="14"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding mmi_code}" Value="">
                    <Setter TargetName="SwatchBorder" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SwatchBorder" Property="Width" Value="0"/>
                    <Setter TargetName="SwatchBorder" Property="Margin" Value="0"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource PanelBorderStyle}" Margin="0,0,0,8">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Select MMI Parameter:" Grid.Row="0" Style="{DynamicResource LabelTextBlockStyle}" Margin="0,0,0,4"/>
                <ComboBox x:Name="parameterComboBox" Grid.Row="1" Style="{DynamicResource SearchableComboBoxStyle}" Tag="Select instance parameter..." SelectionChanged="ParameterComboBox_SelectionChanged"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource PanelBorderStyle}">
            <StackPanel Margin="10,8">
                <TextBlock Text="Monitor Configuration:" Style="{DynamicResource SubheaderTextBlockStyle}" Margin="0,0,0,6"/>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Default on new instances" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Default on new instances" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="Turn on to apply the selected MMI step to new instances when the MMI Monitor is active. Only runs for elements in DocumentChanged added-element IDs that already have the MMI parameter with a blank string. Choose (None) for no default text. Existing instances are not changed by this path." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <ComboBox x:Name="defaultMmiComboBox" Grid.Column="1" Width="108" Height="26" Margin="8,0,8,0"
                              VerticalAlignment="Center" Padding="6,0" VerticalContentAlignment="Center"
                              ItemTemplate="{StaticResource MmiStepItemTemplate}"
                              MaxDropDownHeight="132"
                              Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource ControlBackgroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Style="{DynamicResource DefaultComboBoxStyle}"/>
                    <CheckBox x:Name="defaultOnNewInstancesCheckBox" Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Attempt to fix MMI values" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Attempt to fix MMI values" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="When enabled, attempts to fix MMI values automatically when elements are modified. Checks that values are in correct format (3-digit numbers between 100-999) and auto-corrects invalid values. Examples: '40' becomes '400', '2500' becomes '250'. Shows a balloon notification with details of corrections made. Runs automatically on element modification events." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <CheckBox x:Name="validateMmiCheckBox" Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Pin elements" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Pin elements" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="When enabled, automatically pins elements when their MMI value reaches or exceeds the selected step. Only pins elements that aren't already pinned, and only when the MMI value changes from below the step to the step or above. Shows a notification when elements are pinned. Elements can still be manually unpinned if needed. Default step is 400." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <ComboBox x:Name="pinLimitComboBox" Grid.Column="1" Width="108" Height="26" Margin="8,0,8,0"
                              VerticalAlignment="Center" Padding="6,0" VerticalContentAlignment="Center"
                              ItemTemplate="{StaticResource MmiStepItemTemplate}"
                              MaxDropDownHeight="132"
                              Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource ControlBackgroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Style="{DynamicResource DefaultComboBoxStyle}"/>
                    <CheckBox x:Name="pinElementsCheckBox" Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Warn when moving elements" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Warn when moving elements" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="When enabled, detects when elements with MMI values at or above the selected step are moved more than 0.1 meters. Tracks element locations and shows a balloon warning with details about which elements were moved and how far. Shows the top 5 moved elements with their IDs, MMI values, and movement distance. Default step is 425." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <ComboBox x:Name="moveLimitComboBox" Grid.Column="1" Width="108" Height="26" Margin="8,0,8,0"
                              VerticalAlignment="Center" Padding="6,0" VerticalContentAlignment="Center"
                              ItemTemplate="{StaticResource MmiStepItemTemplate}"
                              MaxDropDownHeight="132"
                              Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource ControlBackgroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Style="{DynamicResource DefaultComboBoxStyle}"/>
                    <CheckBox x:Name="warnOnMoveCheckBox" Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Warn on type changes" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Warn on type changes" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="When enabled, shows a balloon when a family or system type is edited, or when instances are switched to another type, and that type has instances at or above the selected MMI step. The edit is not blocked. Default step is 375." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <ComboBox x:Name="typeChangeLimitComboBox" Grid.Column="1" Width="108" Height="26" Margin="8,0,8,0"
                              VerticalAlignment="Center" Padding="6,0" VerticalContentAlignment="Center"
                              ItemTemplate="{StaticResource MmiStepItemTemplate}"
                              MaxDropDownHeight="132"
                              Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource ControlBackgroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Style="{DynamicResource DefaultComboBoxStyle}"/>
                    <CheckBox x:Name="warnOnTypeChangeCheckBox" Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Warn on instance parameter edits" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Warn on instance parameter edits" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="When enabled, shows a balloon when instance parameters are edited on elements at or above the selected MMI step. Moves, type switches, and instances that only update because their type was edited are not counted. The edit is not blocked. Default step is 375." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <ComboBox x:Name="instanceParamLimitComboBox" Grid.Column="1" Width="108" Height="26" Margin="8,0,8,0"
                              VerticalAlignment="Center" Padding="6,0" VerticalContentAlignment="Center"
                              ItemTemplate="{StaticResource MmiStepItemTemplate}"
                              MaxDropDownHeight="132"
                              Foreground="{DynamicResource TextBrush}"
                              Background="{DynamicResource ControlBackgroundBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Style="{DynamicResource DefaultComboBoxStyle}"/>
                    <CheckBox x:Name="warnOnInstanceParamsCheckBox" Grid.Column="2" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>

                <Grid Margin="0,2" Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Check MMI after sync" Style="{DynamicResource LabelTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="ⓘ" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource DefaultTextBlockStyle}">
                            <TextBlock.ToolTip>
                                <ToolTip Background="{DynamicResource PopupBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="Check MMI after sync" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                        <TextBlock Text="When enabled, tracks user-owned elements before sync, then checks after sync if any are missing MMI values or have invalid MMI values. Creates or updates a 3D view called 'Post-Sync MMI Check' showing problematic elements. Shows a notification with details: count of missing MMI, invalid MMI, and opens the view with elements selected. Only checks elements owned by the current user before sync." TextWrapping="Wrap" MaxWidth="350" Foreground="{DynamicResource TextBrush}" Style="{DynamicResource DefaultTextBlockStyle}"/>
                                    </StackPanel>
                                </ToolTip>
                            </TextBlock.ToolTip>
                        </TextBlock>
                    </StackPanel>
                    <CheckBox x:Name="checkAfterSyncCheckBox" Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" VerticalAlignment="Center" Height="20"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="cancelButton" Content="Cancel" Width="100" Height="30" Margin="0,0,10,0" Style="{DynamicResource StandardButtonStyle}" Click="CancelButton_Click"/>
            <Button x:Name="saveButton" Content="Save" Width="100" Height="30" Style="{DynamicResource SuccessButtonStyle}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
