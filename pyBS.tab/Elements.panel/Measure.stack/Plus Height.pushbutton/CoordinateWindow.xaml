<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="+Height"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="locationRow" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Active location" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"
                       Style="{DynamicResource LabelTextBlockStyle}" Margin="0,0,10,0"/>
            <Border Background="{DynamicResource AccentBrush}" CornerRadius="12"
                    Padding="12,5" VerticalAlignment="Center">
                <TextBlock x:Name="locationPill" Text="" FontSize="13" FontWeight="SemiBold"
                           Foreground="#1F2933" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,16"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Style="{DynamicResource SecondaryTextBlockStyle}"
                   Text="Survey Point uses this location. Project Base Point uses the project origin."/>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Z coordinate system" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextBrush}"
                       Style="{DynamicResource LabelTextBlockStyle}"/>
            <ComboBox x:Name="coordinateCombo"
                      Style="{DynamicResource StandardComboBoxStyle}"
                      Foreground="{DynamicResource TextBrush}"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      Margin="0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,18">
            <TextBlock Text="Multiline text parameter" Margin="0,0,0,6"
                       Foreground="{DynamicResource TextBrush}"
                       Style="{DynamicResource LabelTextBlockStyle}"/>
            <ComboBox x:Name="parameterCombo"
                      Style="{DynamicResource StandardComboBoxStyle}"
                      Foreground="{DynamicResource TextBrush}"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      MaxDropDownHeight="280"
                      Margin="0"/>
        </StackPanel>

        <Grid Grid.Row="4">
            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"
                    Click="load_marker_click" Padding="0" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Load Plushöjdsmarkör" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       TextDecorations="Underline" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Width="100" Margin="0,0,8,0" IsDefault="True"
                        Style="{DynamicResource StandardButtonStyle}" Click="ok_click"/>
                <Button Content="Cancel" Width="100" IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
