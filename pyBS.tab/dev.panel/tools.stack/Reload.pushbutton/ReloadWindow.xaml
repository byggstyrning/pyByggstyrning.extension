<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="pyByggstyrning"
        Width="420"
        SizeToContent="Height"
        MaxHeight="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F5F7"
        ShowInTaskbar="False">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="summaryText" Grid.Row="0" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Foreground="#1F2933" Margin="0,0,0,10"/>

        <Border x:Name="changeCard" Grid.Row="1" Background="White" BorderBrush="#E2E6EC" BorderThickness="1" CornerRadius="6" Padding="12,10,12,10" Margin="0,0,0,14" Visibility="Collapsed">
            <ScrollViewer x:Name="commitScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="commitList"/>
            </ScrollViewer>
        </Border>

        <Button x:Name="updateButton" Grid.Row="2" Content="Update" Height="32" HorizontalAlignment="Right" Padding="18,0" IsDefault="True" Click="UpdateButton_Click"/>
    </Grid>
</Window>
