<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Purge" Width="720" Height="760" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Family Purge" Style="{DynamicResource HeaderTextBlockStyle}"/>
            <TextBlock x:Name="modelInfoText" Style="{DynamicResource SecondaryTextBlockStyle}"
                       Text="Model: -" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="What this does" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="Removes unused content baked into loaded families. It opens each loadable family, deletes what Revit reports as unused, does the same inside nested families, and loads the result back. Families that do not change are left alone."/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="What happens to your model" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="1. The open model is saved as a new file in the folder you pick. A workshared model is saved as a new central. The original file is not overwritten."/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="2. Revit then works on that copy. Nested types that placed instances still select are kept. If a family reload would delete elements or a type, that reload is rolled back and the original nested family stays."/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="3. When it finishes, the open document is the purged copy and it is already saved. Close it and reopen your normal model. This cannot be undone inside the copy."/>
                        <TextBlock Style="{DynamicResource SecondaryTextBlockStyle}" TextWrapping="Wrap"
                                   Text="Open all worksets first. Types used only on a closed workset can look unused. Revit stays busy for the whole run. A large model can take hours. Dialogs during the run are answered automatically, and Save changes is answered No."/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Results" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="Progress goes to the pyRevit output window. The output folder gets family_purge.jsonl and summary.json."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Output folder" Style="{DynamicResource LabelTextBlockStyle}"/>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="folderTextBox" Grid.Column="0" Margin="0,0,8,0"
                             Style="{DynamicResource PlaceholderTextBoxStyle}"
                             Tag="Pick a folder on a drive with enough free space..."
                             TextChanged="folderTextBox_TextChanged"/>
                    <Button x:Name="browseButton" Grid.Column="1" Content="Browse..." Width="100"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Click="browseButton_Click"/>
                </Grid>
                <TextBlock x:Name="spaceText" Style="{DynamicResource SecondaryTextBlockStyle}"
                           Text="" TextWrapping="Wrap"/>
                <CheckBox x:Name="purgeProjectCheckBox" IsChecked="True" Margin="0,8,0,0"
                          Style="{DynamicResource StandardCheckBoxStyle}"
                          Content="Also purge unused project content (keeps levels, grids, views, sheets, links and images)"/>
                <CheckBox x:Name="shareNestedCheckBox" IsChecked="False" Margin="0,8,0,0"
                          Style="{DynamicResource StandardCheckBoxStyle}"
                          Content="Share duplicated nested families (experiment)"/>
                <TextBlock Style="{DynamicResource SecondaryTextBlockStyle}" TextWrapping="Wrap"
                           Margin="22,4,0,0"
                           Text="Off by default. Stores one copy of a nested family that sits in several hosts. Each placement becomes its own element in schedules and tags. A host that would lose a type or an instance is rolled back and keeps its own nested family."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Pick an output folder to start"
                       Style="{DynamicResource DefaultTextBlockStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="runButton" Content="Save copy and purge" Width="160" IsDefault="True"
                        IsEnabled="False"
                        Style="{DynamicResource StandardButtonStyle}"
                        Click="runButton_Click"/>
                <Button x:Name="cancelButton" Content="Cancel" Width="100" IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="cancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
