<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Purge" Width="760" Height="860" MinWidth="640" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Family Purge" Style="{DynamicResource HeaderTextBlockStyle}"/>
            <TextBlock x:Name="modelInfoText" Style="{DynamicResource SecondaryTextBlockStyle}"
                       Text="Model: -" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="168" Margin="0,0,0,8">
            <StackPanel>
                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="What this does" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="Removes unused content baked into the families you check. It opens each one, deletes what Revit reports as unused, does the same inside nested families, and loads the result back. Families you leave unchecked are not opened."/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="What happens to your model" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                        <TextBlock x:Name="modelStep1Text" Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="1. The open model is saved as a new file in the folder you pick. A workshared model is saved as a new central. The original file is not overwritten."/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="2. Revit then works on that copy and purges only the checked families. Nested types that placed instances still select are kept. If a family reload would delete elements or a type, that reload is rolled back and the original nested family stays."/>
                        <TextBlock x:Name="modelStep3Text" Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="3. When it finishes, the open document is the purged copy and it is already saved. Close it and reopen your normal model. This cannot be undone inside the copy."/>
                        <TextBlock Style="{DynamicResource SecondaryTextBlockStyle}" TextWrapping="Wrap"
                                   Text="Open all worksets first. Types used only on a closed workset can look unused. Revit stays busy for the whole run. A large model can take hours. Dialogs during the run are answered automatically, and Save changes is answered No."/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Results" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                        <TextBlock Style="{DynamicResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Text="A bar at the top of Revit shows which family is being purged, and how many are done. The same lines go to the pyRevit output window. The output folder gets family_purge.jsonl and summary.json."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Families to purge" Style="{DynamicResource SubheaderTextBlockStyle}"/>
                <TextBox Grid.Row="1" x:Name="familySearchTextBox" Margin="0,6,0,8"
                         Style="{DynamicResource PlaceholderTextBoxStyle}"
                         Tag="Search by family or category..."
                         TextChanged="familySearchTextBox_TextChanged"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="familySelectAllButton" Content="Select all" Width="100" Margin="0,0,8,0"
                            Style="{DynamicResource StandardButtonStyle}"
                            Click="familySelectAllButton_Click"/>
                    <Button x:Name="familyDeselectAllButton" Content="Deselect all" Width="110"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Click="familyDeselectAllButton_Click"/>
                </StackPanel>
                <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="32,4,8,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="Category"
                                       Style="{DynamicResource SecondaryTextBlockStyle}"
                                       VerticalAlignment="Center" Margin="0"/>
                            <TextBlock Grid.Column="2" Text="Instances" HorizontalAlignment="Right"
                                       Style="{DynamicResource SecondaryTextBlockStyle}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                        <ListBox x:Name="familyListBox"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Style="{DynamicResource DefaultListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="180"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="72"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Checked="familyFilterCheckBox_Changed"
                                                  Unchecked="familyFilterCheckBox_Changed"
                                                  VerticalAlignment="Center"
                                                  Style="{DynamicResource StandardCheckBoxStyle}" Margin="2,2"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FamilyName}"
                                                   Style="{DynamicResource DefaultTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="4,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CategoryName}"
                                                   Style="{DynamicResource SecondaryTextBlockStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding InstanceCount}"
                                                   Style="{DynamicResource DefaultTextBlockStyle}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Row="4" x:Name="familySelectionCountText" Margin="0,6,0,0"
                           Style="{DynamicResource SecondaryTextBlockStyle}"
                           Text="0 of 0 families included"/>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="saveCopyCheckBox" Grid.Column="0" IsChecked="True"
                              Margin="0,0,12,0" VerticalAlignment="Center"
                              Style="{DynamicResource StandardCheckBoxStyle}"
                              Content="Save a new copy"
                              Checked="saveCopyCheckBox_Changed"
                              Unchecked="saveCopyCheckBox_Changed"/>
                    <TextBox x:Name="folderTextBox" Grid.Column="1" Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Style="{DynamicResource PlaceholderTextBoxStyle}"
                             Tag="Output folder..."
                             TextChanged="folderTextBox_TextChanged"/>
                    <Button x:Name="browseButton" Grid.Column="2" Content="Browse..." Width="100"
                            VerticalAlignment="Center"
                            Style="{DynamicResource SecondaryButtonStyle}"
                            Click="browseButton_Click"/>
                </Grid>
                <TextBlock x:Name="spaceText" Style="{DynamicResource SecondaryTextBlockStyle}"
                           Text="" TextWrapping="Wrap"/>
                <CheckBox x:Name="purgeProjectCheckBox" IsChecked="True" Margin="0,8,0,0"
                          Style="{DynamicResource StandardCheckBoxStyle}"
                          Content="Also purge unused project content (keeps levels, grids, views, sheets, links and images)"/>
                <CheckBox x:Name="shareNestedCheckBox" IsChecked="False" Margin="0,8,0,0"
                          Style="{DynamicResource StandardCheckBoxStyle}"
                          Content="Share duplicated nested families (experiment)"/>
                <TextBlock Style="{DynamicResource SecondaryTextBlockStyle}" TextWrapping="Wrap"
                           Margin="22,4,0,0"
                           Text="Off by default. Only checked families are opened. Stores one copy of a nested family that sits in two or more of those families. Each placement becomes its own element in schedules and tags. A host that would lose a type or an instance is rolled back and keeps its own nested family."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="statusText" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Text="Pick an output folder to start"
                       Style="{DynamicResource DefaultTextBlockStyle}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="runButton" Content="Save copy and purge" Width="180" IsDefault="True"
                        IsEnabled="False"
                        Style="{DynamicResource StandardButtonStyle}"
                        Click="runButton_Click"/>
                <Button x:Name="cancelButton" Content="Cancel" Width="100" IsCancel="True"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="cancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
