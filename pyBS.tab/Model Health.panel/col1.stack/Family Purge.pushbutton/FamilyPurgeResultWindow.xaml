<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family purge finished" Width="640" SizeToContent="Height"
        MinHeight="360" MaxHeight="720" MinWidth="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Family purge finished" Style="{DynamicResource HeaderTextBlockStyle}" Margin="0"/>
            <TextBlock x:Name="leadText" Style="{DynamicResource BodyTextBlockStyle}" Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Text="The purged copy is open and already saved."/>
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
            <TextBlock x:Name="originalText" Style="{DynamicResource BodyTextBlockStyle}" Margin="0"
                       TextWrapping="Wrap"
                       Text="Your original file was not overwritten. Close this copy when you are done, then open the original to keep working there."/>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="File size" Style="{DynamicResource SecondaryTextBlockStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="sizeBeforeText" FontSize="18" FontWeight="SemiBold" Margin="0"
                               Foreground="{DynamicResource TextBrush}"
                               Style="{DynamicResource DefaultTextBlockStyle}" Text="-"/>
                    <TextBlock x:Name="sizeAfterText" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextBrush}"
                               Style="{DynamicResource BodyTextBlockStyle}" Text=""/>
                    <TextBlock x:Name="sizeDetailText" FontWeight="SemiBold" Margin="0,4,0,0"
                               Style="{DynamicResource BodyTextBlockStyle}" Text=""/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Families" Style="{DynamicResource SecondaryTextBlockStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="familyBeforeText" FontSize="18" FontWeight="SemiBold" Margin="0"
                               Foreground="{DynamicResource TextBrush}"
                               Style="{DynamicResource DefaultTextBlockStyle}" Text="-"/>
                    <TextBlock x:Name="familyAfterText" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextBrush}"
                               Style="{DynamicResource BodyTextBlockStyle}" Text=""/>
                    <TextBlock x:Name="familyDetailText" FontWeight="SemiBold" Margin="0,4,0,0"
                               Style="{DynamicResource BodyTextBlockStyle}" Text=""/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Placed elements" Style="{DynamicResource SecondaryTextBlockStyle}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="instanceBeforeText" FontSize="18" FontWeight="SemiBold" Margin="0"
                               Foreground="{DynamicResource TextBrush}"
                               Style="{DynamicResource DefaultTextBlockStyle}" Text="-"/>
                    <TextBlock x:Name="instanceAfterText" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextBrush}"
                               Style="{DynamicResource BodyTextBlockStyle}" Text=""/>
                    <TextBlock x:Name="instanceDetailText" FontWeight="SemiBold" Margin="0,4,0,0"
                               Style="{DynamicResource BodyTextBlockStyle}" Text=""/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" x:Name="notesCard" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,12">
            <TextBlock x:Name="notesText" Style="{DynamicResource BodyTextBlockStyle}" Margin="0"
                       TextWrapping="Wrap" Text=""/>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="folderText" Grid.Column="0" VerticalAlignment="Center"
                       Style="{DynamicResource SecondaryTextBlockStyle}" Margin="0,0,12,0"
                       TextWrapping="Wrap" Text=""/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="openButton" Content="Open folder" Width="120" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Click="openButton_Click"/>
                <Button x:Name="closeButton" Content="Close" Width="100" IsDefault="True" IsCancel="True"
                        Style="{DynamicResource StandardButtonStyle}"
                        Click="closeButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
